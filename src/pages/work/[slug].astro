---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedWork from "../../components/RelatedWork.astro";
import CtaBand from "../../components/CtaBand.astro";

export async function getStaticPaths() {
  const projects = await getCollection("caseStudies", ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, allProjects: projects } }));
}
const { project, allProjects } = Astro.props;
const related = allProjects.filter((item: typeof project) => item.id !== project.id).map((item: typeof project) => item.id).slice(0, 2);
---
<BaseLayout title={project.data.client} description={project.data.summary}>
  <section class="case-hero">
    <div>
      <span class="eyebrow light">{project.data.industry} · {project.data.label}</span>
      <h1>{project.data.client}</h1>
      <p>{project.data.summary}</p>
      <div class="case-meta">{project.data.services.map((service: string) => <span>{service}</span>)}</div>
    </div>
    <div class:list={["case-art", project.data.palette]} aria-label={`Abstract project system visual for ${project.data.client}`}></div>
  </section>
  <section class="story-section">
    <div class="story-row">
      <span>01 · The challenge</span>
      <div><h2>Understand the decision, not just the deliverable.</h2><p>{project.data.challenge}</p></div>
    </div>
    <div class="story-row">
      <span>02 · The strategy</span>
      <div><h2>Make the journey feel connected.</h2><p>{project.data.strategy}</p></div>
    </div>
    <div class="story-row">
      <span>03 · What was created</span>
      <div>
        <div class="created-grid">{project.data.created.map((item: string, index: number) => <div><span>0{index + 1}</span><strong>{item}</strong></div>)}</div>
        {project.data.approvedMetrics.length > 0 ? (
          <div class="approved-metrics">{project.data.approvedMetrics.map((metric: {value: string; label: string; period: string}) => <div><strong>{metric.value}</strong><span>{metric.label}</span><small>{metric.period}</small></div>)}</div>
        ) : (
          <p class="disclosure">No unsupported performance metric is published in this case study. Screenshots, measurement periods and approved results can be added after source evidence and client permission are supplied.</p>
        )}
      </div>
    </div>
    <div class="story-row">
      <span>04 · The insight</span>
      <div><h2>{project.data.insight}</h2></div>
    </div>
  </section>
  <section class="section related-section">
    <span class="eyebrow">Continue exploring</span>
    <h2 class="large-section-title">Related work</h2>
    <RelatedWork slugs={related} />
  </section>
  <CtaBand />
</BaseLayout>
