---
import site from "../data/site.json";
import GrowthCheck from "./GrowthCheck.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  copy?: string;
  serviceId?: string;
  growthCheck?: boolean;
}

const {
  eyebrow = "Start a project",
  title = "Hello. Let’s grow.",
  copy = "Tell me where growth is getting stuck. I’ll start there.",
  serviceId,
  growthCheck = false,
} = Astro.props;
const ctaLocation = serviceId ? `service_${serviceId}_final` : "site_cta";
---
<section class:list={["cta-band", { "has-growth-check": growthCheck }]} id={growthCheck ? "growth-check" : undefined}>
  <div class="cta-copy">
  <span class="eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  <p>{copy}</p>
  {serviceId ? (
    <div class="cta-actions">
      <a
        class="button light-button"
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-ga-event="contact_calendly"
        data-ga-method="calendly"
        data-ga-location={ctaLocation}
      >
        Schedule a 30-minute call <span>↗</span>
      </a>
      <a
        class="button cta-secondary"
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-ga-event="contact_whatsapp"
        data-ga-method="whatsapp"
        data-ga-location={ctaLocation}
      >
        Message on WhatsApp <span>↗</span>
      </a>
    </div>
  ) : (
    <a class="button light-button" href="/contact">Start a project <span>↗</span></a>
  )}
  </div>
  {growthCheck && <GrowthCheck location="growth_check_cta" />}
</section>
