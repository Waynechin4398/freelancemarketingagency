---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GrowthConsole from "../components/GrowthConsole.astro";
import SectionIntro from "../components/SectionIntro.astro";
import RelatedWork from "../components/RelatedWork.astro";
import ProcessFlow from "../components/ProcessFlow.astro";
import CtaBand from "../components/CtaBand.astro";
import site from "../data/site.json";

const services = (await getCollection("services", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">{site.location}</span>
      <h1>Turn attention<br />into <em>growth.</em></h1>
      <p>{site.heroIntro}</p>
      <div class="button-row">
        <a class="button primary" href="/work/">Explore our work <span>↗</span></a>
        <a class="button ghost" href="/contact/#audit">Request a growth audit</a>
      </div>
    </div>
    <GrowthConsole />
    <div class="hero-side-note"><span>Scroll to connect the system</span><i></i></div>
  </section>

  <section class="proof-strip" aria-label="Capabilities">
    <span>Web development</span><i></i>
    <span>Paid acquisition</span><i></i>
    <span>Multilingual campaigns</span><i></i>
    <span>Social & lifecycle</span><i></i>
    <span>CRM & measurement</span>
  </section>

  <section class="work-preview section">
    <SectionIntro number="01" eyebrow="Selected experience" title="The work behind the thinking." copy="Real project contexts, the role Wayne Omni played and the systems created. Public metrics are withheld unless they can be supported and approved." />
    <RelatedWork slugs={["singapore-luxury-homes", "langkawi-sunset-cruise", "sweetie-lending"]} />
    <div class="section-foot">
      <span>Additional experience</span>
      <div><span><b>KamiDental</b> · Healthcare</span><span><b>Summer Marine</b> · Marine</span></div>
      <a href="/work/">View all work ↗</a>
    </div>
  </section>

  <section class="services-home section dark-section">
    <SectionIntro number="02" eyebrow="Connected capabilities" title="One marketing system. Not six disconnected services." copy="Strategy, creative, media and technology are designed around the same customer journey." light />
    <div class="service-list">
      {services.map((service) => (
        <a href={`/services/${service.id}/`}>
          <span>{service.data.number}</span>
          <div><h3>{service.data.title}</h3><p>{service.data.short}</p></div>
          <b>{service.data.group}</b><i>↗</i>
        </a>
      ))}
    </div>
  </section>

  <section class="system-section section">
    <SectionIntro number="03" eyebrow="The growth operating system" title="See every handoff. Improve the whole journey." copy="The strongest gains often appear between channels—where an ad becomes a page visit, a form becomes a lead, and a lead becomes a timely conversation." />
    <ProcessFlow />
  </section>

  <section class="principles section">
    <div class="principles-lead"><span class="eyebrow">How we work</span><h2>Clear before clever.<br />Evidence before ego.</h2></div>
    <div class="principle-grid">
      <article><span>01</span><h3>Start with the constraint</h3><p>Find the part of the journey holding growth back before prescribing a channel.</p></article>
      <article><span>02</span><h3>Design the handoffs</h3><p>Make the transition from attention to action—and from lead to follow-up—deliberate.</p></article>
      <article><span>03</span><h3>Build for learning</h3><p>Use measurement to make the next decision clearer, not to decorate a report.</p></article>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
