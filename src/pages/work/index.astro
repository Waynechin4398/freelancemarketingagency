---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";

const projects = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const serviceFilters = ["Websites", "Landing Pages", "Paid Media", "SEO & Content", "CRM & Automation", "Social Media", "Analytics"];
const filters = [
  { label: "All work", value: "All", count: projects.length },
  ...serviceFilters
    .map((service) => ({ label: service, value: service, count: projects.filter((project) => project.data.services.includes(service)).length }))
    .filter((filter) => filter.count > 0),
];

const experience = [
  {
    period: "2020–2023",
    company: "SeventyBrokers",
    role: "Senior Marketing Executive",
    field: "Forex / Financial Services",
    proof: "Managed more than USD150K in B2C media spend, improved customer-acquisition efficiency by 25%, and grew cross-platform social audiences by 20,000 over two years.",
    capabilities: ["Meta & Google Ads", "Funnels", "Retargeting", "Social Growth"],
  },
  {
    period: "2021–2022",
    company: "Capital.com",
    role: "SEO Specialist & Translator",
    field: "Forex / CFD",
    proof: "Built Chinese-language search visibility and localised more than 200 articles, newsletters and analytical reports from English to Chinese.",
    capabilities: ["Chinese SEO", "Ahrefs", "Localisation", "Editorial QA"],
  },
  {
    period: "2022",
    company: "ebright.my",
    role: "Lead Generation Specialist",
    field: "Education",
    proof: "Created Google Ads campaigns and conversion landing pages for course registrations, with an average reported cost per lead of approximately RM25.",
    capabilities: ["Google Ads", "Landing Pages", "Lead Generation"],
  },
  {
    period: "Independent practice",
    company: "Multilingual Web & Commerce",
    role: "Builder and Growth Operator",
    field: "Cross-industry",
    proof: "Built WordPress, Wix and Shopify websites while connecting paid media, Meta Pixel, Google Tag Manager and customer follow-up across English and Chinese campaigns.",
    capabilities: ["WordPress", "Wix", "Shopify", "Tracking"],
  },
];
---
<BaseLayout title="Work" description="Documented Wayne Omni work across web, SEO, paid acquisition, social media, analytics and marketing automation.">
  <PageHero
    eyebrow="Selected experience"
    title="Work that connects attention to action."
    intro="Explore documented project work across real estate, PropTech, healthcare, SaaS, marine tourism and finance. The collection shows the operating context, systems created and Wayne's role where recorded—not just the final screen."
  />

  <section class="work-proof" aria-label="Experience overview">
    <div><span>Operating range</span><strong>Web → Media → CRM</strong></div>
    <div><span>Campaign languages</span><strong>English + Chinese</strong></div>
    <div><span>Working model</span><strong>Strategy + Execution</strong></div>
    <div><span>Evidence policy</span><strong>Context before claims</strong></div>
  </section>

  <nav class="filters" aria-label="Filter projects by service">
    {filters.map((filter, index) => (
      <button
        type="button"
        data-filter={filter.value}
        data-filter-key={filter.value.toLowerCase().replaceAll(" & ", "-").replaceAll(" ", "-")}
        class:list={{ active: index === 0 }}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        <span>{filter.label}</span><small>{String(filter.count).padStart(2, "0")}</small>
      </button>
    ))}
  </nav>

  <div class="filter-summary">
    <p data-filter-status>Showing all {projects.length} documented projects.</p>
    <a href="#experience-archive">View experience archive ↓</a>
  </div>

  <div class="work-grid" data-work-grid aria-live="polite">
    {projects.map((project, index) => {
      const leadMetric = project.data.approvedMetrics[0];
      return (
        <a
          class:list={["project-card", project.data.palette]}
          data-project
          data-services={JSON.stringify(project.data.services)}
          href={`/work/${project.id}/`}
        >
          <div class="project-topline">
            <span class="project-count">{String(index + 1).padStart(2, "0")}</span>
            <span>{project.data.period ?? project.data.label}</span>
          </div>
          <div class="project-visual" aria-hidden="true">
            <div class="mini-window"><i></i><i></i><i></i><b></b></div>
            <div class="mini-data"><i></i><i></i><i></i><i></i></div>
            {leadMetric && <div class="project-result"><strong>{leadMetric.value}</strong><span>{leadMetric.label}</span></div>}
          </div>
          <div class="project-copy">
            <span class="eyebrow">{project.data.industry} · {project.data.objective}</span>
            <h2>{project.data.client}</h2>
            {(project.data.role || project.data.period) && (
              <p class="project-role">{project.data.role}{project.data.role && project.data.period ? " · " : ""}{project.data.period}</p>
            )}
            <p>{project.data.summary}</p>
            <div class="project-tags" aria-label="Services">{project.data.services.slice(0, 4).map((service) => <span>{service}</span>)}</div>
            <span class="text-link">Read case study <b>↗</b></span>
          </div>
        </a>
      );
    })}
  </div>
  <p class="empty-state" data-empty hidden>No published project currently matches this capability.</p>

  <section class="experience-archive" id="experience-archive">
    <div class="archive-heading">
      <span class="eyebrow">Experience archive</span>
      <h2>Earlier work that shaped the operating range.</h2>
      <p>Selected roles and independent work that add depth in multilingual SEO, financial-services acquisition, social growth and web delivery.</p>
    </div>
    <div class="archive-list">
      {experience.map((item, index) => (
        <article>
          <div class="archive-index"><span>{String(index + 1).padStart(2, "0")}</span><small>{item.period}</small></div>
          <div class="archive-title"><h3>{item.company}</h3><p>{item.role} · {item.field}</p></div>
          <p class="archive-proof">{item.proof}</p>
          <div class="archive-tags">{item.capabilities.map((capability) => <span>{capability}</span>)}</div>
        </article>
      ))}
    </div>
    <p class="archive-note">Performance figures above are drawn from Wayne's supplied professional project record and retain their stated campaign context. They are not guarantees of future results.</p>
  </section>

  <CtaBand />

  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-project]"));
    const empty = document.querySelector<HTMLElement>("[data-empty]");
    const status = document.querySelector<HTMLElement>("[data-filter-status]");

    const applyFilter = (active: string, updateUrl = true) => {
      let visible = 0;
      buttons.forEach((button) => {
        const selected = button.dataset.filter === active;
        button.classList.toggle("active", selected);
        button.setAttribute("aria-pressed", String(selected));
      });
      cards.forEach((card) => {
        const services = JSON.parse(card.dataset.services ?? "[]") as string[];
        const show = active === "All" || services.includes(active);
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      if (status) status.textContent = active === "All"
        ? `Showing all ${visible} documented projects.`
        : `Showing ${visible} ${active} ${visible === 1 ? "project" : "projects"}.`;
      if (updateUrl) {
        const url = new URL(window.location.href);
        const activeButton = buttons.find((button) => button.dataset.filter === active);
        if (active === "All") url.searchParams.delete("service");
        else url.searchParams.set("service", activeButton?.dataset.filterKey ?? "");
        window.history.replaceState({}, "", url);
      }
    };

    buttons.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "All")));
    const syncFromUrl = () => {
      const requested = new URL(window.location.href).searchParams.get("service");
      const match = buttons.find((button) => button.dataset.filterKey === requested);
      applyFilter(match?.dataset.filter ?? "All", false);
    };
    window.addEventListener("popstate", syncFromUrl);
    syncFromUrl();
  </script>
</BaseLayout>

<style>
  .work-proof { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 2px solid var(--ink); background: var(--ink); gap: 2px; }
  .work-proof div { min-height: 132px; padding: 1.25rem var(--pad); background: var(--metal-light); display: flex; flex-direction: column; justify-content: space-between; }
  .work-proof span { font-size: .57rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #5b6068; }
  .work-proof strong { font: 750 clamp(.95rem, 1.45vw, 1.35rem)/1.15 var(--display); letter-spacing: -.025em; }
  .filters button { display: inline-flex; align-items: center; gap: .9rem; }
  .filters small { color: #7d8189; font-size: .52rem; }
  .filters button.active small { color: #c7cad0; }
  .filter-summary { padding: 1rem var(--pad); display: flex; justify-content: space-between; gap: 2rem; border-bottom: 2px solid var(--ink); background: var(--white); }
  .filter-summary p, .filter-summary a { margin: 0; font-size: .64rem; font-weight: 700; }
  .filter-summary a { color: var(--cobalt); }
  .project-topline { position: relative; z-index: 2; display: flex; justify-content: space-between; color: var(--muted); font-size: .58rem; text-transform: uppercase; letter-spacing: .08em; }
  .project-result { position: absolute; z-index: 3; right: 0; top: 0; width: 42%; min-height: 112px; padding: 1rem; background: var(--cobalt); color: white; display: flex; flex-direction: column; justify-content: flex-end; border: 2px solid var(--ink); }
  .project-result strong { font: 800 clamp(1.55rem, 3vw, 2.8rem)/.9 var(--display); letter-spacing: -.055em; }
  .project-result span { margin-top: .45rem; font-size: .54rem; line-height: 1.3; text-transform: uppercase; letter-spacing: .07em; }
  .project-role { margin: -.35rem 0 .85rem !important; color: var(--ink) !important; font-size: .66rem !important; font-weight: 750; }
  .experience-archive { padding: clamp(5rem, 9vw, 8rem) var(--pad); background: var(--ink); color: white; scroll-margin-top: 150px; }
  .archive-heading { display: grid; grid-template-columns: .55fr 1.45fr; column-gap: 8vw; row-gap: 1.5rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .archive-heading > .eyebrow { grid-row: 1 / span 2; }
  .archive-heading h2 { margin: 0; max-width: 12ch; font: 750 clamp(2.8rem, 5.5vw, 6rem)/.92 var(--display); letter-spacing: -.06em; }
  .archive-heading p { margin: 0; max-width: 690px; color: #a9adb5; line-height: 1.75; }
  .archive-list { border-top: 2px solid #3e4148; }
  .archive-list article { display: grid; grid-template-columns: .42fr .8fr 1.35fr .8fr; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid #34373d; align-items: start; }
  .archive-index { display: flex; gap: 1.2rem; }
  .archive-index span { color: var(--cobalt); font-size: .62rem; font-weight: 800; }
  .archive-index small { color: #8d9199; font-size: .6rem; }
  .archive-title h3 { margin: 0 0 .55rem; font: 750 clamp(1.2rem, 2vw, 1.8rem)/1 var(--display); letter-spacing: -.035em; }
  .archive-title p, .archive-proof { margin: 0; color: #a9adb5; font-size: .72rem; line-height: 1.7; }
  .archive-tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .archive-tags span { padding: .4rem .5rem; border: 1px solid #3e4148; color: #c8cbd0; font-size: .52rem; text-transform: uppercase; letter-spacing: .06em; }
  .archive-note { max-width: 780px; margin: 2rem 0 0 auto; color: #7f838b; font-size: .62rem; line-height: 1.7; }

  @media (max-width: 900px) {
    .work-proof { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .archive-heading { grid-template-columns: 1fr; }
    .archive-heading > .eyebrow { grid-row: auto; }
    .archive-list article { grid-template-columns: .35fr 1fr 1.4fr; }
    .archive-tags { grid-column: 2 / -1; }
  }
  @media (max-width: 620px) {
    .work-proof { grid-template-columns: 1fr 1fr; }
    .work-proof div { min-height: 112px; padding: 1rem; }
    .filter-summary { align-items: flex-start; flex-direction: column; gap: .5rem; }
    .project-result { width: 48%; }
    .archive-list article { grid-template-columns: 1fr; gap: 1.2rem; }
    .archive-tags { grid-column: auto; }
    .archive-index { justify-content: space-between; }
  }
</style>
