---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GrowthConsole from "../components/GrowthConsole.astro";
import SectionIntro from "../components/SectionIntro.astro";
import RelatedWork from "../components/RelatedWork.astro";
import ProcessFlow from "../components/ProcessFlow.astro";
import CtaBand from "../components/CtaBand.astro";
import ResultsStrip from "../components/ResultsStrip.astro";
import HeroCharacter from "../components/HeroCharacter.astro";
import SignalValues from "../components/SignalValues.astro";
import ServiceRows from "../components/ServiceRows.astro";
import site from "../data/site.json";

const services = (await getCollection("services", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featuredWork = ["singapore-luxury-homes", "propertylab-webinar-acquisition", "summercharter-summermarine"];
const portfolio = (await getCollection("caseStudies", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="signal-hero" aria-labelledby="hero-title">
    <span class="eyebrow">Hi, I’m Wayne · Growth partner, Malaysia</span>
    <h1 id="hero-title" class="signal-hero-title" data-no-stagger>
      <span class="sr-only">Growth, on target. </span>
      <span class="signal-hero-display" aria-hidden="true">
        <span class="line">Growth,</span>
        <span class="line"><HeroCharacter />n target.</span>
      </span>
    </h1>
    <div class="signal-hero-bottom">
      <div>
        <p>{site.heroIntro}</p>
        <div class="button-row">
          <a class="button primary" href="/contact">Start a project <span aria-hidden="true">↗</span></a>
          <a class="button ghost" href="/work/">See the work <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <a class="hero-sticker" href="#growth-check" aria-label="Take the 30-second growth check">
        <svg viewBox="0 0 160 160" aria-hidden="true">
          <defs><path id="sticker-ring" d="M80,80 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"></path></defs>
          <circle class="sticker-bg" cx="80" cy="80" r="77"></circle>
          <g class="sticker-spin"><text><textPath href="#sticker-ring" textLength="360" lengthAdjust="spacing">30-second growth check ◎ take it now ◎</textPath></text></g>
        </svg>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </section>

  <section class="proof-strip motion-marquee" aria-label="What Wayne Omni connects">
    <div class="motion-marquee-track">
      <div class="motion-marquee-item"><span>Websites, ads &amp; follow-up that actually talk to each other</span><i></i><span>Build</span><i></i><span>Acquire</span><i></i><span>Engage</span><i></i><span>Automate</span><i></i><span>Measure</span><i></i></div>
      <div class="motion-marquee-item" aria-hidden="true"><span>Websites, ads &amp; follow-up that actually talk to each other</span><i></i><span>Build</span><i></i><span>Acquire</span><i></i><span>Engage</span><i></i><span>Automate</span><i></i><span>Measure</span><i></i></div>
    </div>
  </section>

  <ResultsStrip />

  <SignalValues />

  <ServiceRows
    services={services}
    copy="Pick the part of your customer journey that needs to work harder. Each service links strategy, execution and measurement to one clear next step."
    showAllLink
  />

  <section class="work-preview section">
    <SectionIntro number="03" eyebrow="Selected work" title="Proof, not promises." copy="Documented project contexts, the role I played, the systems created and—where the measurement context is available—the reported result." />
    <RelatedWork slugs={featuredWork} />
    <div class="client-chips">
      <span>In the portfolio</span>
      <ul>
        {portfolio.map((project) => <li><a href={`/work/${project.id}/`}>{project.data.client}</a></li>)}
      </ul>
      <a class="button ghost" href="/work/">View all work <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="console-feature section dark-section">
    <SectionIntro number="04" eyebrow="How I work" title="One brain. The whole journey." copy="I work where strategy, design, media and technology meet—so the promise in the ad still makes sense on the page, in the CRM and during follow-up." light />
    <div class="console-feature-grid">
      <div class="console-manifesto">
        <span>WAYNE OMNI / SYSTEM 01</span>
        <p>Most growth problems are not isolated channel problems. They happen in the handoffs. I design those handoffs as one operating system.</p>
        <a href="/about/">More about my approach ↗</a>
      </div>
      <GrowthConsole />
    </div>
  </section>

  <section class="system-section section" id="growth-system">
    <SectionIntro number="05" eyebrow="The growth operating system" title="Every handoff, on target." copy="The strongest gains often appear between channels—where an ad becomes a page visit, a form becomes a lead, and a lead becomes a timely conversation." />
    <ProcessFlow />
  </section>

  <CtaBand growthCheck />
</BaseLayout>
