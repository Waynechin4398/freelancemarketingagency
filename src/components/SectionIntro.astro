---
interface Props { number?: string; eyebrow: string; title: string; copy?: string; light?: boolean; }
const { number, eyebrow, title, copy, light = false } = Astro.props;
---
<div class:list={["section-intro", { light }]}>
  <div>{number && <span class="section-number">{number}</span>}<span class="eyebrow">{eyebrow}</span></div>
  <div><h2>{title}</h2>{copy && <p>{copy}</p>}</div>
</div>
