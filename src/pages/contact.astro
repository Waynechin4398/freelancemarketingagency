---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import site from "../data/site.json";
---
<BaseLayout title="Schedule a meeting" description="Book a focused 30-minute meeting with Wayne Omni.">
  <PageHero dark eyebrow="Start a conversation" title="Hello! Let’s talk growth." intro="Book a focused 30-minute meeting or message Wayne directly on WhatsApp." />
  <section class="brief-section" id="audit" aria-labelledby="brief-title">
    <div class="brief-intro">
      <span class="eyebrow">Guided project brief</span>
      <h2 id="brief-title">Give the first conversation useful context.</h2>
      <p>Share the business, website and growth problem you want to solve. It comes straight to me—no email app needed—and I reply personally within one business day.</p>
      <p>You’ll get a copy of your brief in your inbox, so you have a record of what you sent.</p>
    </div>
    <div class="brief-shell">
      <form class="project-brief" data-project-brief data-async action={site.leadEndpoint} method="post" data-contact-email={site.contactEmail} data-booking-url={site.bookingUrl}>
        <div class="form-field">
          <label for="brief-name">Your name <span aria-hidden="true">*</span></label>
          <input id="brief-name" name="name" type="text" autocomplete="name" maxlength="120" required />
        </div>
        <div class="form-field">
          <label for="brief-email">Email address <span aria-hidden="true">*</span></label>
          <input id="brief-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required />
        </div>
        <div class="form-field">
          <label for="brief-company">Company</label>
          <input id="brief-company" name="company" type="text" autocomplete="organization" maxlength="160" />
        </div>
        <div class="form-field">
          <label for="brief-site">Website</label>
          <input id="brief-site" name="website" type="text" autocomplete="url" inputmode="url" placeholder="example.com" maxlength="300" />
        </div>
        <div class="form-field form-field-wide">
          <label for="brief-details">What would you like to improve? <span aria-hidden="true">*</span></label>
          <p id="brief-details-hint">Include the current situation, the outcome you want and any useful timing or constraints.</p>
          <textarea id="brief-details" name="brief" rows="8" minlength="15" maxlength="1600" aria-describedby="brief-details-hint" required></textarea>
        </div>
        <div class="form-hp" aria-hidden="true">
          <label for="brief-fax">Leave this empty</label>
          <input id="brief-fax" name="fax" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label class="form-consent form-field-wide">
          <input type="checkbox" name="consent" required />
          <span>I agree that Wayne Omni may use these details to reply to my enquiry, as described in the <a href="/privacy/">Privacy Notice</a> and <a href="/pdpa/">PDPA notice</a>. <span aria-hidden="true">*</span></span>
        </label>
        {site.turnstileSiteKey && <div class="form-turnstile form-field-wide" data-turnstile data-sitekey={site.turnstileSiteKey}></div>}
        <div class="form-actions form-field-wide">
          <button class="button primary" type="submit">Send my brief <span aria-hidden="true">↗</span></button>
          <p class="form-note">Required fields are marked *. Your details are only used to reply to you.</p>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </div>
      </form>
      <div class="brief-success" data-brief-success hidden tabindex="-1" aria-labelledby="brief-success-title">
        <span class="brief-success-mark" aria-hidden="true">✓</span>
        <span class="eyebrow">Brief received</span>
        <h3 id="brief-success-title">Thanks<span data-success-name></span>. It’s on my desk.</h3>
        <p data-success-copy>I’ll read it properly and reply personally within one business day.</p>
        <div class="button-row">
          <a class="button primary" href={site.bookingUrl} target="_blank" rel="noopener noreferrer" data-ga-event="contact_calendly" data-ga-method="calendly" data-ga-location="brief_success">Book a 30-min call now <span aria-hidden="true">↗</span></a>
          <a class="button ghost" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" data-ga-event="contact_whatsapp" data-ga-method="whatsapp" data-ga-location="brief_success">WhatsApp me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
  <section class="contact-layout">
    <div class="contact-copy">
      <span class="eyebrow">Direct contact</span>
      <h2>Choose the easiest way to start.</h2>
      <p>Schedule a 30-minute call for a focused conversation. If you have a quick question, message me directly on WhatsApp.</p>
      <div class="button-row">
        <a class="button primary" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Message Wayne on WhatsApp (opens in a new tab)" data-ga-event="contact_whatsapp" data-ga-method="whatsapp" data-ga-location="contact_page">
          Message on WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="prelaunch-note"><strong>Email Wayne directly</strong><br /><a href={`mailto:${site.contactEmail}`} data-ga-event="contact_email" data-ga-method="email" data-ga-location="contact_page">{site.contactEmail}</a></div>
    </div>
    <aside class="schedule-card" id="schedule" aria-labelledby="schedule-title">
      <div class="schedule-card-top">
        <span class="eyebrow">Calendly</span>
        <span>30 minutes</span>
      </div>
      <h2 id="schedule-title">Schedule a focused meeting.</h2>
      <p>Choose an available time to discuss your priorities, current marketing setup and the clearest next step.</p>
      <div class="schedule-details">
        <div><span>Format</span><strong>Online meeting</strong></div>
        <div><span>Duration</span><strong>30 minutes</strong></div>
        <div><span>Useful for</span><strong>Project fit · Priorities · Next steps</strong></div>
      </div>
      <a class="button primary" href={site.bookingUrl} target="_blank" rel="noopener noreferrer" aria-label="View available meeting times on Calendly (opens in a new tab)" data-ga-event="contact_calendly" data-ga-method="calendly" data-ga-location="contact_page">
        View available times <span aria-hidden="true">↗</span>
      </a>
      <p class="schedule-note">Your Calendly booking page will open in a new tab.</p>
    </aside>
  </section>
</BaseLayout>

<script>
  type TurnstileApi = { render: (el: HTMLElement, opts: Record<string, unknown>) => string; reset: (id?: string) => void; getResponse: (id?: string) => string | undefined };
  type BriefWindow = Window & { turnstile?: TurnstileApi; gtag?: (...args: unknown[]) => void; __onTurnstileLoad?: () => void };
  const w = window as BriefWindow;
  let turnstileId: string | undefined;

  const renderTurnstile = () => {
    const slot = document.querySelector<HTMLElement>("[data-turnstile]");
    if (!slot || !w.turnstile || slot.dataset.rendered === "true") return;
    slot.dataset.rendered = "true";
    turnstileId = w.turnstile.render(slot, { sitekey: slot.dataset.sitekey, theme: "light", appearance: "interaction-only", action: "project_brief" });
  };

  const loadTurnstile = () => {
    if (!document.querySelector("[data-turnstile]")) return;
    if (w.turnstile) return renderTurnstile();
    if (document.querySelector("script[data-turnstile-api]")) return;
    w.__onTurnstileLoad = renderTurnstile;
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__onTurnstileLoad";
    script.async = true;
    script.defer = true;
    script.dataset.turnstileApi = "true";
    document.head.append(script);
  };

  const mailtoFallback = (form: HTMLFormElement, data: Record<string, string>) => {
    const to = form.dataset.contactEmail ?? "";
    const subject = data.company ? `Project brief from ${data.name} — ${data.company}` : `Project brief from ${data.name}`;
    const body = [`Name: ${data.name}`, `Email: ${data.email}`, `Company: ${data.company || "Not provided"}`, `Website: ${data.website || "Not provided"}`, "", "Project brief:", data.brief].join("\n");
    return `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  const initializeProjectBrief = () => {
    const form = document.querySelector<HTMLFormElement>("[data-project-brief]");
    if (!form || form.dataset.briefReady === "true") return;
    form.dataset.briefReady = "true";
    turnstileId = undefined;
    loadTurnstile();

    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const success = document.querySelector<HTMLElement>("[data-brief-success]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.dataset.sending === "true") return;
      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => { data[key] = String(value).trim(); });
      data.page = window.location.pathname;
      if (w.turnstile && turnstileId !== undefined) data["cf-turnstile-response"] = w.turnstile.getResponse(turnstileId) ?? "";

      form.dataset.sending = "true";
      button?.classList.add("is-loading");
      button?.setAttribute("aria-busy", "true");
      if (status) status.textContent = "Sending your brief…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify(data),
        });
        const result = await response.json().catch(() => ({ ok: false, error: "" })) as { ok?: boolean; error?: string; copy?: boolean; fields?: Record<string, string> };
        if (!response.ok || !result.ok) {
          const fieldName = result.fields ? Object.keys(result.fields)[0] : "";
          const field = fieldName ? form.querySelector<HTMLElement>(`[name="${fieldName}"]`) : null;
          field?.focus();
          throw Object.assign(new Error(result.error || "Something went wrong."), { retryable: response.status >= 500 || response.status === 0 });
        }

        w.gtag?.("event", "generate_lead", { form_name: "project_brief", method: "website_form", page_location: window.location.href });
        const firstName = (data.name || "").split(/\s+/)[0];
        if (success) {
          const nameSlot = success.querySelector<HTMLElement>("[data-success-name]");
          if (nameSlot) nameSlot.textContent = firstName ? `, ${firstName}` : "";
          const copy = success.querySelector<HTMLElement>("[data-success-copy]");
          if (copy && result.copy) copy.textContent = `A copy is on its way to ${data.email}. I’ll read it properly and reply personally within one business day.`;
          form.hidden = true;
          success.hidden = false;
          success.focus({ preventScroll: true });
          success.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
        }
      } catch (error) {
        const message = error instanceof TypeError || !(error instanceof Error) ? "Couldn’t reach the server." : error.message;
        const retryable = !(error instanceof Error) || (error as Error & { retryable?: boolean }).retryable !== false;
        if (status) {
          status.textContent = "";
          status.append(`${message} `);
          if (retryable) {
            const link = document.createElement("a");
            link.href = mailtoFallback(form, data);
            link.textContent = "Send it by email instead";
            status.append(link, ".");
          }
        }
        if (w.turnstile && turnstileId !== undefined) w.turnstile.reset(turnstileId);
      } finally {
        form.dataset.sending = "false";
        button?.classList.remove("is-loading");
        button?.removeAttribute("aria-busy");
      }
    });
  };

  document.addEventListener("astro:page-load", initializeProjectBrief);
  if (document.readyState !== "loading") initializeProjectBrief();
</script>
