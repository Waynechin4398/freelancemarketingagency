<div class="console" data-growth-console aria-label="Interactive agent console (illustrative)">
  <div class="console-top"><span class="console-kicker">Agent console <b>01</b></span><span class="status"><i></i> Agents working</span></div>
  <div class="console-tabs" role="tablist" aria-label="AI agents">
    {["Ads", "Social", "Video", "Email", "Web", "Search"].map((channel, index) => (
      <button role="tab" data-channel={channel} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>{channel}</button>
    ))}
  </div>
  <div class="console-stage cobalt" data-console-stage aria-live="polite">
    <div class="console-axis" aria-hidden="true"><span>Read</span><span>Create</span><span>Review</span></div>
    <div class="signal-card"><span data-console-label>Ads Agent · today</span><strong data-console-value>Pause → replace</strong><p data-console-detail>Two tired creatives flagged. Three new angles drafted for Wayne’s review.</p></div>
    <div class="signal-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="console-orbit" aria-hidden="true"><b></b><b></b><b></b></div>
  </div>
  <div class="console-foot"><span data-console-module>Module 01 / 06</span><span>Illustrative · Human approval required</span></div>
</div>
<script>
  const channelData = {
    Ads: ["Ads Agent · today", "Pause → replace", "Two tired creatives flagged. Three new angles drafted for Wayne’s review.", "cobalt"],
    Social: ["Social Agent · today", "Trend → draft", "Next week’s posts drafted in English, 中文 and Bahasa Melayu.", "coral"],
    Video: ["Video Agent · today", "Hook → cut", "Best-performing hook turned into three short-video variations.", "lime"],
    Email: ["Email Agent · today", "Lead → follow-up", "Follow-up sequence drafted for this week’s new enquiries.", "cyan"],
    Web: ["Web Agent · today", "Ad → page", "Landing page headline matched to the winning ad message.", "pink"],
    Search: ["Search Agent · today", "Question → answer", "FAQ drafted for a question buyers are asking AI assistants.", "amber"],
  };
  const initializeGrowthConsoles = () => document.querySelectorAll<HTMLElement>("[data-growth-console]").forEach((consoleElement) => {
    if (consoleElement.dataset.consoleReady === "true") return;
    consoleElement.dataset.consoleReady = "true";
    const tabs = Array.from(consoleElement.querySelectorAll<HTMLButtonElement>("[data-channel]"));
    const activate = (button: HTMLButtonElement) => {
        const channel = button.dataset.channel as keyof typeof channelData;
        const [label, value, detail, tone] = channelData[channel];
        tabs.forEach((item) => {
          item.setAttribute("aria-selected", String(item === button));
          item.tabIndex = item === button ? 0 : -1;
        });
        const stage = consoleElement.querySelector<HTMLElement>("[data-console-stage]");
        stage?.classList.add("is-switching");
        window.setTimeout(() => {
          if (stage) stage.className = `console-stage ${tone}`;
        const labelEl = consoleElement.querySelector("[data-console-label]");
        const valueEl = consoleElement.querySelector("[data-console-value]");
        const detailEl = consoleElement.querySelector("[data-console-detail]");
        const moduleEl = consoleElement.querySelector("[data-console-module]");
        if (labelEl) labelEl.textContent = label;
        if (valueEl) valueEl.textContent = value;
        if (detailEl) detailEl.textContent = detail;
          if (moduleEl) moduleEl.textContent = `Module ${String(tabs.indexOf(button) + 1).padStart(2, "0")} / 06`;
        }, window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 190);
    };
    tabs.forEach((button, index) => {
      button.addEventListener("click", () => activate(button));
      button.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        tabs[nextIndex].focus();
        activate(tabs[nextIndex]);
      });
    });
  });
  document.addEventListener("astro:page-load", initializeGrowthConsoles);
  if (document.readyState !== "loading") initializeGrowthConsoles();
</script>
