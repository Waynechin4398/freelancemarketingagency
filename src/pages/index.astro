---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GrowthConsole from "../components/GrowthConsole.astro";
import SectionIntro from "../components/SectionIntro.astro";
import RelatedWork from "../components/RelatedWork.astro";
import ProcessFlow from "../components/ProcessFlow.astro";
import CtaBand from "../components/CtaBand.astro";
import ServicesSkewedCarousel from "../components/ServicesSkewedCarousel.astro";
import site from "../data/site.json";

const services = (await getCollection("services", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="hero personal-hero">
    <div class="hero-copy">
      <div class="hero-index"><span>01</span><span>Who I am</span></div>
      <span class="eyebrow">Independent growth partner · Malaysia</span>
      <h1><span>I’m Wayne.</span><br />I build the systems<br />behind <em>growth.</em></h1>
      <p>{site.heroIntro}</p>
      <div class="hero-roles" aria-label="Core capabilities">
        <span>Strategy</span><span>Web</span><span>Paid media</span><span>Automation</span>
      </div>
      <div class="button-row">
        <a class="button primary" href="/work/">Explore our work <span>↗</span></a>
        <a class="button ghost" href="/contact/#audit">Request a growth audit</a>
      </div>
    </div>
    <div class="portrait-stage" aria-label="Portrait of Wayne">
      <span class="portrait-letter" aria-hidden="true">W</span>
      <span class="metal-disc" aria-hidden="true"></span>
      <span class="blue-plane" aria-hidden="true"></span>
      <img src="/images/wayne-portrait.png" width="1080" height="1350" alt="Wayne, founder of Wayne Omni" fetchpriority="high" />
      <div class="portrait-nameplate"><b>WAYNE</b><span>Strategy / Build / Growth</span></div>
      <div class="portrait-coordinates" aria-hidden="true"><span>MY · 03.14°N</span><span>101.69°E</span></div>
    </div>
    <div class="hero-side-note"><span>Scroll to see the system</span><i></i></div>
  </section>

  <section class="proof-strip" aria-label="Capabilities">
    <span>Build</span><i></i>
    <span>Acquire</span><i></i>
    <span>Engage</span><i></i>
    <span>Automate</span><i></i>
    <span>Measure</span>
  </section>

  <section class="console-feature section dark-section">
    <SectionIntro number="02" eyebrow="How I work" title="One operator across the whole customer journey." copy="I work where strategy, design, media and technology meet—so the promise in the ad still makes sense on the page, in the CRM and during follow-up." light />
    <div class="console-feature-grid">
      <div class="console-manifesto">
        <span>WAYNE OMNI / SYSTEM 01</span>
        <p>Most growth problems are not isolated channel problems. They happen in the handoffs. I design those handoffs as one operating system.</p>
        <a href="/about/">More about my approach ↗</a>
      </div>
      <GrowthConsole />
    </div>
  </section>

  <section class="work-preview section">
    <SectionIntro number="03" eyebrow="Selected experience" title="The work behind the thinking." copy="Documented project contexts, the role I played, the systems created and—where the measurement context is available—the reported result." />
    <RelatedWork slugs={["singapore-luxury-homes", "propertylab-webinar-acquisition", "summercharter-summermarine"]} />
    <div class="section-foot">
      <span>More documented work</span>
      <div><span><b>KamiDental</b> · Healthcare</span><span><b>CHATDADDY</b> · SaaS</span></div>
      <a href="/work/">View all work ↗</a>
    </div>
  </section>

  <ServicesSkewedCarousel services={services} />

  <section class="system-section section">
    <SectionIntro number="05" eyebrow="The growth operating system" title="See every handoff. Improve the whole journey." copy="The strongest gains often appear between channels—where an ad becomes a page visit, a form becomes a lead, and a lead becomes a timely conversation." />
    <ProcessFlow />
  </section>

  <section class="principles section">
    <div class="principles-lead"><span class="eyebrow">How we work</span><h2>Clear before clever.<br />Evidence before ego.</h2></div>
    <div class="principle-grid">
      <article><span>01</span><h3>Start with the constraint</h3><p>Find the part of the journey holding growth back before prescribing a channel.</p></article>
      <article><span>02</span><h3>Design the handoffs</h3><p>Make the transition from attention to action—and from lead to follow-up—deliberate.</p></article>
      <article><span>03</span><h3>Build for learning</h3><p>Use measurement to make the next decision clearer, not to decorate a report.</p></article>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
