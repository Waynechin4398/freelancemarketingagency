---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Page not found" noindex>
  <PageHero dark eyebrow="404 · Not found" title="This path does not connect." intro="The page may have moved. Return to the homepage or explore the work." />
  <div class="button-row not-found-actions"><a class="button primary" href="/">Return home <span>↗</span></a><a class="button ghost" href="/work/">Explore work</a></div>
</BaseLayout>
