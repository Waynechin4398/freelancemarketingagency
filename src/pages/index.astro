---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GrowthConsole from "../components/GrowthConsole.astro";
import SectionIntro from "../components/SectionIntro.astro";
import RelatedWork from "../components/RelatedWork.astro";
import CtaBand from "../components/CtaBand.astro";
import ResultsStrip from "../components/ResultsStrip.astro";
import HeroCharacter from "../components/HeroCharacter.astro";
import SignalValues from "../components/SignalValues.astro";
import ServiceRows from "../components/ServiceRows.astro";
import AgentTeam from "../components/AgentTeam.astro";
import AgentLoop from "../components/AgentLoop.astro";
import CompareTable from "../components/CompareTable.astro";
import Guardrails from "../components/Guardrails.astro";
import site from "../data/site.json";

const services = (await getCollection("services", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featuredWork = ["singapore-luxury-homes", "propertylab-webinar-acquisition", "summercharter-summermarine"];
const portfolio = (await getCollection("caseStudies", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="signal-hero" aria-labelledby="hero-title">
    <span class="eyebrow">AI agent marketing team · Steered by Wayne · Malaysia</span>
    <h1 id="hero-title" class="signal-hero-title" data-no-stagger>
      <span class="sr-only">Growth, always on. </span>
      <span class="signal-hero-display" aria-hidden="true">
        <span class="line">Growth,</span>
        <span class="line"><span class="hero-word">always</span><HeroCharacter />n.</span>
      </span>
    </h1>
    <div class="signal-hero-bottom">
      <div>
        <p>{site.heroIntro}</p>
        <div class="button-row">
          <a class="button primary" href="#growth-check">Get my free growth check <span aria-hidden="true">↗</span></a>
          <a class="button ghost" href="/ai-agents/">Meet the agents <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="hero-proofline" aria-label="What the agent team covers">
          <li>Ads</li><li>Social</li><li>Video</li><li>Email</li><li>Web</li><li>SEO · AEO · GEO</li>
        </ul>
      </div>
      <a class="hero-sticker" href="#growth-check" aria-label="Take the 30-second growth check">
        <svg viewBox="0 0 160 160" aria-hidden="true">
          <defs><path id="sticker-ring" d="M80,80 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"></path></defs>
          <circle class="sticker-bg" cx="80" cy="80" r="77"></circle>
          <g class="sticker-spin"><text><textPath href="#sticker-ring" textLength="360" lengthAdjust="spacing">30-second growth check ◎ take it now ◎</textPath></text></g>
        </svg>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </section>

  <section class="proof-strip motion-marquee" aria-label="What the Wayne Omni agent team runs">
    <div class="motion-marquee-track">
      <div class="motion-marquee-item"><span>AI agents do the work. Wayne steers.</span><i></i><span>Ads</span><i></i><span>Social</span><i></i><span>Video</span><i></i><span>Email</span><i></i><span>Web</span><i></i><span>Search</span><i></i></div>
      <div class="motion-marquee-item" aria-hidden="true"><span>AI agents do the work. Wayne steers.</span><i></i><span>Ads</span><i></i><span>Social</span><i></i><span>Video</span><i></i><span>Email</span><i></i><span>Web</span><i></i><span>Search</span><i></i></div>
    </div>
  </section>

  {site.showWork && <ResultsStrip />}

  <SignalValues />

  <section class="loop-section section" id="the-loop">
    <SectionIntro number="01" eyebrow="The agent loop" title="One loop. Every day." copy="Most marketing improves once a month, after the report. Here the agents read the data, propose the next test, create the assets and wait for my approval, every single day." />
    <AgentLoop />
  </section>

  <AgentTeam showLink />

  <CompareTable />

  <section class="console-feature section dark-section">
    <SectionIntro number="02" eyebrow="Watch the agents work" title="One brain. Seven agents." copy="Each agent owns one channel, and they all share the same data. So the promise in the ad still makes sense on the page, in the email and in the follow-up." light />
    <div class="console-feature-grid">
      <div class="console-manifesto">
        <span>WAYNE OMNI / AGENT TEAM</span>
        <p>Most growth problems happen in the handoffs between channels. A team of agents that shares one brain does not drop them.</p>
        <a href="/ai-agents/">See how the agent team works ↗</a>
      </div>
      <div>
        <GrowthConsole />
        <p class="console-demo-note">Illustrative examples of daily agent tasks, not live client data.</p>
      </div>
    </div>
  </section>

  {site.showWork && (
  <section class="work-preview section">
    <SectionIntro number="03" eyebrow="Selected work" title="Proof, not promises." copy="Documented project contexts, the role I played, the systems created and, where the measurement context is available, the reported result. This is the experience the agents are trained on and steered by." />
    <RelatedWork slugs={featuredWork} />
    <div class="client-chips">
      <span>In the portfolio</span>
      <ul>
        {portfolio.map((project) => <li><a href={`/work/${project.id}/`}>{project.data.client}</a></li>)}
      </ul>
      <a class="button ghost" href="/work/">View all work <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  )}

  <Guardrails />

  <ServiceRows
    services={services}
    eyebrow="Or start with one service"
    copy="You do not have to hire the whole agent team at once. Pick the part of your customer journey that needs to work harder first."
    showAllLink
  />

  <CtaBand growthCheck eyebrow="Free growth check" title="Hello. Let’s grow." copy="Answer three quick questions and see where an agent team would start. No pitch deck, no obligation." />
</BaseLayout>
