---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Page not found" noindex>
  <PageHero dark eyebrow="404 · Not found" title="Oops. Missed the target." intro="This page may have moved. Head back to the homepage or look through the services." />
  <div class="button-row not-found-actions"><a class="button primary" href="/">Return home <span>↗</span></a><a class="button ghost" href="/services/">Explore services</a></div>
</BaseLayout>
