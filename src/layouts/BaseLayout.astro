---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${site.brand} — ${site.descriptor}`,
  description = "Connected websites, campaigns and marketing systems built in Malaysia for businesses across markets.",
  noindex = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL("/og.png", Astro.site) : "/og.png";
const pageTitle = title.startsWith(site.brand) ? title : `${title} — ${site.brand}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.legalName,
  alternateName: site.brand,
  url: Astro.site?.toString(),
  logo: Astro.site ? new URL("/images/wayne-omni-logo.png", Astro.site).toString() : "/images/wayne-omni-logo.png",
  description,
  areaServed: ["Malaysia", "Singapore", "Southeast Asia"],
  knowsAbout: ["Website development", "Landing pages", "Paid media", "Social media", "Email marketing", "CRM and marketing automation"],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/wayne-omni-logo.png" />
    <link rel="apple-touch-icon" href="/images/wayne-omni-logo.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#0237ff" />
    <meta name="google-site-verification" content="hYYLKQxIv8oE0I-0RH7PoVSzFSuKoiRZzP90wQBS7u8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WPMY8CH9ZJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-WPMY8CH9ZJ');
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <a
      class="whatsapp-float"
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Message Wayne on WhatsApp (opens in a new tab)"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.009-.371-.011-.57-.011-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.989c-.002 5.45-4.437 9.884-9.89 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
      <span>WhatsApp</span>
    </a>
    <script>
      document.querySelectorAll("[data-menu-toggle]").forEach((toggle) => {
        const nav = document.querySelector<HTMLElement>("#mobile-nav");
        const closeMenu = () => {
          toggle.setAttribute("aria-expanded", "false");
          toggle.textContent = "Menu";
          nav?.classList.remove("open");
          nav?.setAttribute("aria-hidden", "true");
          if (nav) nav.inert = true;
          document.body.classList.remove("menu-open");
        };
        toggle.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") !== "true";
          toggle.setAttribute("aria-expanded", String(open));
          toggle.textContent = open ? "Close" : "Menu";
          nav?.classList.toggle("open", open);
          nav?.setAttribute("aria-hidden", String(!open));
          if (nav) nav.inert = !open;
          document.body.classList.toggle("menu-open", open);
        });
        nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            closeMenu();
            (toggle as HTMLElement).focus();
          }
        });
      });

      const header = document.querySelector(".site-header");
      const syncHeader = () => header?.classList.toggle("scrolled", window.scrollY > 12);
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      const revealTargets = document.querySelectorAll(".section-intro, .related-card, .service-list > a, .funnel-step, .principle-grid > article, .project-card, .insight-card, .story-row, .detail-grid");
      if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        revealTargets.forEach((element, index) => {
          element.classList.add("reveal");
          (element as HTMLElement).style.setProperty("--reveal-delay", `${Math.min(index % 4, 3) * 70}ms`);
        });
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -6%" });
        revealTargets.forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
