---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import site from "../data/site.json";
---
<BaseLayout title="Page not found" noindex>
  <PageHero dark eyebrow="404 · Not found" title="Oops. Missed the target." intro={site.showWork ? "This page may have moved. Head back to the homepage or explore the work." : "This page may have moved. Head back to the homepage or explore the services."} />
  <div class="button-row not-found-actions"><a class="button primary" href="/">Return home <span>↗</span></a>{site.showWork ? <a class="button ghost" href="/work/">Explore work</a> : <a class="button ghost" href="/services/">Explore services</a>}</div>
</BaseLayout>
